43,y+.12],[.54,y],[.31,-.39],[0,-.49],[-.31,-.39],[.31,-.39]]) points.push(new THREE.Vector3(x,v,0));\n }\n const line=new THREE.CatmullRomCurve3(points).getPoints(383);\n const positions=this.geometry.attributes.position;\n line.forEach((p,i)=>positions.setXYZ(i,p.x,p.y,p.z));\n positions.needsUpdate=true;\n}","enabled":true,"assetBehavior":"stream"}]},"history":{"undos":[],"redos":[]}}
